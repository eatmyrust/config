#!/usr/bin/env bash
#
# Prints a GitHub App installation token on stdout, for use as devsh's
# GITHUB_TOKEN_CMD. The token expires in an hour, and each call can narrow it to
# specific repositories and permissions, so one App backs several devsh profiles
# at different levels of access.
#
# Scope only ever narrows. Asking for more than the installation was granted is
# a 422 from GitHub, not a wider token.

set -euo pipefail

APP_ID="${GH_APP_ID:-}"
APP_KEY="${GH_APP_KEY:-}"
INSTALLATION="${GH_APP_INSTALLATION:-}"
REPOS=""
PERMISSIONS=""
LIST=false

die() { echo "gh-app-token: $*" >&2; exit 1; }

usage() {
  cat <<'EOF'
Usage: gh-app-token [--repos a,b] [--permissions k=v,k=v]
       gh-app-token --list

  --repos a,b          limit the token to these repositories, by name alone
                       (not owner/repo); default is the whole installation
  --permissions k=v    limit the token to these permissions, e.g.
                       contents=read,pull_requests=write; default is everything
                       the installation was granted
  --installation ID    which installation to mint for
  --app-id ID          the App's id (its client id also works)
  --key PATH           the App's private key PEM
  --list               list this App's installations and their ids

The last three default to $GH_APP_INSTALLATION, $GH_APP_ID, and $GH_APP_KEY.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --repos) REPOS="$2"; shift 2 ;;
    --permissions) PERMISSIONS="$2"; shift 2 ;;
    --installation) INSTALLATION="$2"; shift 2 ;;
    --app-id) APP_ID="$2"; shift 2 ;;
    --key) APP_KEY="$2"; shift 2 ;;
    --list) LIST=true; shift ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown option '$1'; see --help" ;;
  esac
done

[[ -n "$APP_ID" ]] || die "no app id; pass --app-id or set GH_APP_ID"
[[ -n "$APP_KEY" ]] || die "no private key; pass --key or set GH_APP_KEY"
[[ -r "$APP_KEY" ]] || die "private key '$APP_KEY' is not readable"

b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }

# GitHub caps exp - iat at 10 minutes and rejects a JWT issued even a second in
# its own future, so iat is backdated to absorb clock drift.
now="$(date +%s)"
header="$(printf '%s' '{"alg":"RS256","typ":"JWT"}' | b64url)"
payload="$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' "$((now - 60))" "$((now + 480))" "$APP_ID" | b64url)"
signature="$(printf '%s.%s' "$header" "$payload" | openssl dgst -sha256 -sign "$APP_KEY" -binary | b64url)"
JWT="$header.$payload.$signature"

api() {
  curl -sS \
    -H "Authorization: Bearer $JWT" \
    -H "Accept: application/vnd.github+json" \
    -H "X-GitHub-Api-Version: 2022-11-28" \
    "$@"
}

if [[ "$LIST" == true ]]; then
  api https://api.github.com/app/installations |
    jq -r '.[] | "\(.id)\t\(.account.login)\t\(.repository_selection)"'
  exit 0
fi

[[ -n "$INSTALLATION" ]] ||
  die "no installation id; pass --installation, set GH_APP_INSTALLATION, or run --list to find one"

body="$(jq -n --arg repos "$REPOS" --arg perms "$PERMISSIONS" '
  (if $repos == "" then {} else
    {repositories: ($repos | split(",") | map(gsub("^\\s+|\\s+$"; "")) | map(select(length > 0)))}
  end)
  +
  (if $perms == "" then {} else
    {permissions: ($perms | split(",") | map(gsub("^\\s+|\\s+$"; "")) | map(select(length > 0))
      | map(split("=") | {key: .[0], value: .[1]}) | from_entries)}
  end)')"

response="$(api -X POST -d "$body" \
  "https://api.github.com/app/installations/$INSTALLATION/access_tokens")"

token="$(jq -r '.token // empty' <<<"$response")"
[[ -n "$token" ]] || die "$(jq -r '.message // "token request failed"' <<<"$response")"
printf '%s\n' "$token"
