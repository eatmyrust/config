#!/usr/bin/env bash
#
# Runs the dev container with one profile's worth of credentials rather than
# the whole of $HOME.
#
# A profile names an AWS profile, a kube context, and a command that prints a
# GitHub token. Each is resolved on the host into a 0700 scratch directory,
# mounted into the container, and deleted when the container exits.
#
# Deliberately one path per provider. Anything AWS or kubectl already knows how
# to do belongs in ~/.aws/config or ~/.kube/config rather than in here: a
# profile with role_arn/source_profile exports as the assumed role on its own,
# and an exec-based context (EKS, GKE) keeps working inside the container
# because the image has aws-cli and the credentials are mounted alongside it.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
IMAGE="${DEVSH_IMAGE:-eatmyrust/devcontainer:latest}"

die() { echo "devsh: $*" >&2; exit 1; }

usage() {
  cat <<'EOF'
Usage: devsh <profile> [command...]   run the dev container with those credentials
       devsh --list                   list profiles
       devsh --build                  rebuild the image

Profiles are profiles/<name>.env, holding any of:

  DESCRIPTION         one line, shown by --list
  AWS_SOURCE_PROFILE  host AWS profile to export temporary credentials from
  KUBE_CONTEXT        host kube context to expose, on its own
  GITHUB_TOKEN_CMD    host command whose stdout is a GitHub token

Leave a key out and the container gets no access to that provider. Profiles
hold no secrets, only names and a command, so they are safe to commit.
EOF
}

case "${1:-}" in
  ""|-h|--help) usage; exit 0 ;;
  --build) exec docker build -t "$IMAGE" "$REPO_ROOT" ;;
  --list)
    for file in "$REPO_ROOT"/profiles/*.env; do
      printf '  %-16s %s\n' "$(basename "$file" .env)" "$(. "$file"; echo "${DESCRIPTION:-}")"
    done
    exit 0
    ;;
esac

PROFILE="$1"
shift
FILE="$REPO_ROOT/profiles/$PROFILE.env"
[[ -f "$FILE" ]] || die "no profile '$PROFILE'; 'devsh --list' shows what is available"
# shellcheck disable=SC1090
. "$FILE" || die "profile $FILE did not load; a value containing spaces needs quoting"

DIR="$(mktemp -d)"
chmod 700 "$DIR"
trap 'rm -rf "$DIR"' EXIT

MOUNTS=()
printf 'DEVSH_PROFILE=%s\n' "$PROFILE" > "$DIR/env"

if [[ -n "${AWS_SOURCE_PROFILE:-}" ]]; then
  # env-no-export emits exactly the KEY=value lines --env-file expects, so this
  # needs no parsing. An SSO or role_arn profile resolves to temporary
  # credentials here, and only for the one account named.
  aws configure export-credentials --profile "$AWS_SOURCE_PROFILE" --format env-no-export >> "$DIR/env" ||
    die "could not export AWS credentials for profile '$AWS_SOURCE_PROFILE'"
fi

if [[ -n "${KUBE_CONTEXT:-}" ]]; then
  # --minify drops every cluster, user, and context but the one named; --flatten
  # inlines the certificates they point at.
  kubectl config view --minify --flatten --context="$KUBE_CONTEXT" > "$DIR/kubeconfig" ||
    die "context '$KUBE_CONTEXT' is not in this machine's kubeconfig"
  # The container user's uid differs from this one's and a bind mount carries
  # the host mode through, so 0600 would be unreadable inside. $DIR being 0700
  # is what keeps other host users out.
  chmod 644 "$DIR/kubeconfig"
  MOUNTS+=(-v "$DIR/kubeconfig:/home/dev/.kube/config:ro")
fi

if [[ -n "${GITHUB_TOKEN_CMD:-}" ]]; then
  TOKEN="$(eval "$GITHUB_TOKEN_CMD")" || die "GITHUB_TOKEN_CMD failed: $GITHUB_TOKEN_CMD"
  [[ -n "$TOKEN" ]] || die "GITHUB_TOKEN_CMD printed nothing: $GITHUB_TOKEN_CMD"
  printf 'GITHUB_TOKEN=%s\nGH_TOKEN=%s\n' "$TOKEN" "$TOKEN" >> "$DIR/env"
fi

echo "==> devsh '$PROFILE': aws=${AWS_SOURCE_PROFILE:-none} kube=${KUBE_CONTEXT:-none} github=${GITHUB_TOKEN_CMD:-none}"

# The image is normally already here, built from this repo and pushed to the
# Hub. Build it if it is not, rather than letting docker run try to pull a tag
# that may not exist yet and report it as a registry auth failure.
docker image inspect "$IMAGE" >/dev/null 2>&1 || docker build -t "$IMAGE" "$REPO_ROOT"

# -t only when there is a terminal to attach, so `devsh <profile> <command>`
# still works from a script or a pipe.
RUN=(--rm -i)
if [[ -t 0 ]]; then RUN+=(-t); fi

docker run "${RUN[@]}" \
  --env-file "$DIR/env" \
  ${MOUNTS[@]+"${MOUNTS[@]}"} \
  -v "$PWD:/home/dev/workdir" \
  -w /home/dev/workdir \
  "$IMAGE" "$@"
