DEVBOX_DESCRIPTION="Homelab Kubernetes only, no cloud and no GitHub write access"

KUBE_CONTEXT=admin@homelab
KUBE_NAMESPACE=default

# Until a ServiceAccount exists, this profile hands over a copy of the admin
# client certificate, which never expires. Create one and uncomment the two
# lines below to swap it for an 8 hour token scoped to a single namespace:
#
#   kubectl --context=admin@homelab -n default create serviceaccount devbox
#   kubectl --context=admin@homelab -n default create rolebinding devbox \
#     --clusterrole=edit --serviceaccount=default:devbox
#
# KUBE_SERVICE_ACCOUNT=devbox
# KUBE_TOKEN_DURATION=8h
