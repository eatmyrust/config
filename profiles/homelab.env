DESCRIPTION="Homelab Kubernetes, plus a GitHub token"

KUBE_CONTEXT=admin@homelab
GITHUB_TOKEN_CMD="gh auth token"

# This machine has no AWS profiles yet. On one that does, and preferring a
# profile whose ~/.aws/config entry carries role_arn, so what gets exported is
# an assumed role rather than your own identity:
# AWS_SOURCE_PROFILE=prod-ro

# GITHUB_TOKEN_CMD is just a host command, so any secret store works:
# GITHUB_TOKEN_CMD="op read op://Private/devsh-github/token"
