#!/usr/bin/env bash
#MISE description="Install third-party agent skills via the Skills CLI"
#
# Fetched at bootstrap time rather than vendored into home/.agents/skills/,
# which holds only custom skills.

set -euo pipefail

# The plugin manifest lists Matt's curated set; the repo also holds
# in-progress and course-specific skills that `--skill '*'` would pull in.
MATTPOCOCK_MANIFEST=https://raw.githubusercontent.com/mattpocock/skills/main/.claude-plugin/plugin.json
manifest="$(curl -fsSL "$MATTPOCOCK_MANIFEST")"
mapfile -t MATTPOCOCK < <(jq -er '.skills[] | split("/") | last' <<<"$manifest")
((${#MATTPOCOCK[@]})) || { echo "no skills in $MATTPOCOCK_MANIFEST" >&2; exit 1; }
VERCEL_LABS=(find-skills)

add() {
  local source="$1" skill args=()
  shift
  for skill in "$@"; do
    args+=(--skill "$skill")
  done
  npx --yes skills add "$source" -g -y -a claude-code "${args[@]}"
}

add mattpocock/skills "${MATTPOCOCK[@]}"
add vercel-labs/skills "${VERCEL_LABS[@]}"
