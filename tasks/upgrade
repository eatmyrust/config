#!/usr/bin/env bash
#MISE description="Upgrade system packages, repos, mise, and dev tools"

set -euo pipefail

if [[ -z "${GITHUB_TOKEN:-}" ]]; then
  if gh_token="$(gh auth token 2>/dev/null)"; then
    export GITHUB_TOKEN="$gh_token"
  else
    echo "no GitHub token available; mise may hit API rate limits" >&2
  fi
fi

set -x

mise bootstrap packages upgrade --yes
mise bootstrap packages prune --yes
mise bootstrap repos update --yes
mise self-update -y
mise upgrade

mise lock --global

mise prune --tools

